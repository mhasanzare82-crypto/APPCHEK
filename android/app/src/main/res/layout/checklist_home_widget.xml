<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/checklist_widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="چک‌لیست‌های من"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:background="#55FFFFFF"
        android:text="" />

    <TextView
        android:id="@+id/widget_content_sans"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="برای انتخاب چک‌لیست لمس کن"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans"
        android:gravity="top" />

    <TextView
        android:id="@+id/widget_content_serif"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="برای انتخاب چک‌لیست لمس کن"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:fontFamily="serif"
        android:gravity="top"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_content_mono"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="برای انتخاب چک‌لیست لمس کن"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="top"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="برای انتخاب لمس کن  ›"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp" />
</LinearLayout>
